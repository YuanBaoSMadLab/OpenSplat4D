#include "/Engine/Public/Platform.ush"

// OpenSplat4D — Gaussian-splat billboard shaders (v2 – SH-aware).
//
// One instance == one Gaussian. GPU buffer layout (18 float4 per point):
//   0: (PosX, PosY, PosZ, AnchorTime)
//   1: (QuatX, QuatY, QuatZ, QuatW)
//   2: (ScaleX, ScaleY, ScaleZ, TimeVariance)
//   3: (ColorR, ColorG, ColorB, ColorA)   ← pre-computed DC-only colour (fallback)
//   4: (VelX, VelY, VelZ, bUseVelocity)
//   5: (raw_f_dc_0, raw_f_dc_1, raw_f_dc_2, raw_opacity)
//   6..17: f_rest[1..44] packed into 12 float4s (3 ch × 15 SH coeffs)
//
// SH evaluation runs in the vertex shader (once per gaussian, not per pixel)
// and passes the final colour through FSplatVOut.Color.

struct FSplatVOut
{
	float4 Position   : SV_POSITION;
	float2 UV         : TEXCOORD0;
	float4 Color      : TEXCOORD1;   // final SH-evaluated colour + opacity
	float3 Cov2D      : TEXCOORD2;
	float  TimeWeight : TEXCOORD3;
};

StructuredBuffer<float4> Points;

float4x4 ViewProjection;
float4   CameraRight;
float4   CameraUp;
float4   CameraPos;
float    Time;
int      bTemporalWeighting;
int      PointCount;
int      SHDegree;         // 0=DC only, 1-3=SH bands beyond DC
float    SplatScale = 1.0f;

// ==========================================================================
// Spherical Harmonics
// ==========================================================================

static const float SH_C0 = 0.28209479177387814;

// l=0
float SH00(float3 d) { return SH_C0; }

// l=1
float SH1m1(float3 d) { return  0.4886025119029199 * d.y; }
float SH10 (float3 d) { return  0.4886025119029199 * d.z; }
float SH1p1(float3 d) { return  0.4886025119029199 * d.x; }

// l=2
float SH2m2(float3 d) { return  1.0925484305920792 * d.x * d.y; }
float SH2m1(float3 d) { return  1.0925484305920792 * d.y * d.z; }
float SH20 (float3 d) { return  0.31539156525252005 * (3.0 * d.z * d.z - 1.0); }
float SH2p1(float3 d) { return  1.0925484305920792 * d.x * d.z; }
float SH2p2(float3 d) { return  0.5462742152960396 * (d.x * d.x - d.y * d.y); }

// l=3
float SH3m3(float3 d) { return  0.5900435899266435 * d.y * (3.0 * d.x * d.x - d.y * d.y); }
float SH3m2(float3 d) { return  2.890611442640554  * d.x * d.y * d.z; }
float SH3m1(float3 d) { return  0.4570457994644658 * d.y * (5.0 * d.z * d.z - 1.0); }
float SH30 (float3 d) { return  0.3731763325901154 * d.z * (5.0 * d.z * d.z - 3.0); }
float SH3p1(float3 d) { return  0.4570457994644658 * d.x * (5.0 * d.z * d.z - 1.0); }
float SH3p2(float3 d) { return  1.445305721320277  * d.z * (d.x * d.x - d.y * d.y); }
float SH3p3(float3 d) { return  0.5900435899266435 * d.x * (d.x * d.x - 3.0 * d.y * d.y); }

// Evaluate SH for one colour channel.  `f_dc` is the raw DC coefficient.
// `shData` is the base slot index (in Points[]) for that channel's f_rest.
// f_rest for each channel is tightly packed:
//   channel R: shData+0..shData+3  (15 coeffs in 4 float4s)
//   channel G: shData+0..shData+3  (same layout, different base)
//   channel B: shData+0..shData+3
float EvalSH(float f_dc, int shBase, float3 dir, int deg)
{
	float result = SH_C0 * f_dc;

	if (deg >= 1)
	{
		result += Points[shBase + 0].x * SH1m1(dir);
		result += Points[shBase + 0].y * SH10(dir);
		result += Points[shBase + 0].z * SH1p1(dir);
	}
	if (deg >= 2)
	{
		result += Points[shBase + 0].w * SH2m2(dir);
		result += Points[shBase + 1].x * SH2m1(dir);
		result += Points[shBase + 1].y * SH20(dir);
		result += Points[shBase + 1].z * SH2p1(dir);
		result += Points[shBase + 1].w * SH2p2(dir);
	}
	if (deg >= 3)
	{
		result += Points[shBase + 2].x * SH3m3(dir);
		result += Points[shBase + 2].y * SH3m2(dir);
		result += Points[shBase + 2].z * SH3m1(dir);
		result += Points[shBase + 2].w * SH30(dir);
		result += Points[shBase + 3].x * SH3p1(dir);
		result += Points[shBase + 3].y * SH3p2(dir);
		result += Points[shBase + 3].z * SH3p3(dir);
	}
	return result;
}

float4 EvalSHColour(int5 shOffsets, float3 dir, int deg)
{
	// shOffsets: base for DC/opacity slot, then R, G, B f_rest bases
	float4 dc = Points[shOffsets.x];  // (f_dc_r, f_dc_g, f_dc_b, raw_opacity)

	float r = EvalSH(dc.x, shOffsets.y, dir, deg);
	float g = EvalSH(dc.y, shOffsets.z, dir, deg);
	float b = EvalSH(dc.z, shOffsets.w, dir, deg);

	float sig_r = 1.0 / (1.0 + exp(-r));
	float sig_g = 1.0 / (1.0 + exp(-g));
	float sig_b = 1.0 / (1.0 + exp(-b));
	float sig_a = 1.0 / (1.0 + exp(-dc.w));

	return float4(sig_r, sig_g, sig_b, sig_a);
}


// ==========================================================================
// Geometry
// ==========================================================================

float3x3 QuatToMatrix(float4 Q)
{
	float x = Q.x, y = Q.y, z = Q.z, w = Q.w;
	float3x3 M;
	M[0] = float3(1 - 2*(y*y + z*z), 2*(x*y + w*z),     2*(x*z - w*y));
	M[1] = float3(    2*(x*y - w*z), 1 - 2*(x*x + z*z), 2*(y*z + w*x));
	M[2] = float3(    2*(x*z + w*y), 2*(y*z - w*x),     1 - 2*(x*x + y*y));
	return M;
}

float3x3 BuildCovariance(float3 Scale, float4 Quat)
{
	float3x3 R = QuatToMatrix(Quat);
	float3 S2 = Scale * Scale;
	float3x3 S = float3x3(
		float3(S2.x,0,0), float3(0,S2.y,0), float3(0,0,S2.z));
	return mul(mul(R, S), transpose(R));
}

float3 ProjectCovarianceTo2D(float3x3 Cov3D, float3 Right, float3 Up, float Depth)
{
	float3x3 V;
	V[0] = float3(Right.x, Up.x, 0);
	V[1] = float3(Right.y, Up.y, 0);
	V[2] = float3(Right.z, Up.z, 1);
	float3x3 CovView = mul(mul(V, Cov3D), transpose(V));

	float J = 1.0 / max(Depth, 1e-3);
	float3x3 Jm = float3x3(float3(J,0,0), float3(0,J,0), float3(0,0,1));
	float3x3 CovImg = mul(mul(Jm, CovView), transpose(Jm));

	return float3(CovImg[0][0] + 0.3, CovImg[0][1], CovImg[1][1] + 0.3);
}

float TimeWeight(float AnchorTime, float TimeVariance, float T)
{
	float Variance = max(TimeVariance, 1e-6);
	float Dt = AnchorTime - T;
	return exp(-0.5 * Dt * Dt / Variance);
}

float2 QuadCorner(uint Vid)
{
	if (Vid == 0) return float2(-1,-1);
	if (Vid == 1) return float2(-1, 1);
	if (Vid == 2) return float2( 1, 1);
	if (Vid == 3) return float2(-1,-1);
	if (Vid == 4) return float2( 1, 1);
	return float2( 1,-1);
}


// ==========================================================================
// Main
// ==========================================================================

FSplatVOut MainVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
	int i = InstanceID;
	int base = i * 18;

	float3 pos     = Points[base + 0].xyz;
	float4 quat    = Points[base + 1];
	float3 scale   = Points[base + 2].xyz;
	float4 color   = Points[base + 3];        // fallback DC colour
	float anchorT  = Points[base + 0].w;
	float timeVar  = Points[base + 2].w;
	float3 vel     = Points[base + 4].xyz;
	float useVel   = Points[base + 4].w;

	float tw = bTemporalWeighting ? TimeWeight(anchorT, timeVar, Time) : 1.0;
	float3 worldPos = pos + (bTemporalWeighting ? vel * useVel * (Time - anchorT) : 0.0);

	// ---- SH evaluation (vertex shader: once per gaussian) ----
	if (SHDegree > 0)
	{
		float3 viewDir = normalize(CameraPos.xyz - worldPos);
		// SH data: slot 5 = (f_dc_r, f_dc_g, f_dc_b, raw_opacity)
		// R f_rest at slot 6, G at slot 10, B at slot 14 (4 float4s each)
		int5 shOffsets = int5(base + 5, base + 6, base + 10, base + 14, 0);
		color = EvalSHColour(shOffsets, viewDir, SHDegree);
	}

	float2 corner = QuadCorner(VertexID);
	float size = max(max(scale.x, scale.y), scale.z) * SplatScale;
	float3 offset = (CameraRight.xyz * corner.x + CameraUp.xyz * corner.y) * size;
	float3 finalPos = worldPos + offset;

	float3x3 Cov3D = BuildCovariance(scale, quat);
	float3 Right = CameraRight.xyz;
	float3 Up    = CameraUp.xyz;
	float3 Cov2D = ProjectCovarianceTo2D(Cov3D, Right, Up, max(length(finalPos), 1e-2));

	FSplatVOut o;
	o.Position = mul(float4(finalPos, 1.0), ViewProjection);
	o.UV = corner;
	o.Color = color;
	o.Cov2D = Cov2D;
	o.TimeWeight = tw;
	return o;
}

float4 MainPS(FSplatVOut i) : SV_Target0
{
	float3 cov = i.Cov2D;
	float2 D = i.UV;
	float a = cov.x, b = cov.y, c = cov.z;
	float det = a * c - b * b;
	float invDet = 1.0 / max(det, 1e-6);
	float2 v = float2(a * D.x + b * D.y, b * D.x + c * D.y) * invDet;
	float falloff = exp(-0.5 * dot(D, v));

	float alpha = saturate(i.Color.a * i.TimeWeight * falloff);
	return float4(i.Color.rgb, alpha);
}
